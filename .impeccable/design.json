    {
      "name": "Arrival primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The warm-paper headset entry action; its disabled state signals unavailable VR.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 7h14l2 10h-6l-3-3-3 3H3L5 7Z M7 11h2m6 0h2\"/></svg>Step inside in VR</button>",
      "css": ".ds-primary{font:600 16px \"Segoe UI\",sans-serif;width:100%;min-height:58px;border:0;border-radius:4px;color:var(--ink,#173e4b);background:var(--paper,#fff9e8);display:flex;gap:12px;justify-content:center;align-items:center;box-shadow:0 7px 24px #06334b25;cursor:pointer}.ds-primary svg{width:24px;stroke:currentColor;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}.ds-primary:hover:not(:disabled){background:#f4dcaa}.ds-primary:disabled{opacity:.7;cursor:default}.ds-primary:focus-visible{outline:3px solid var(--focus,#edbc65);outline-offset:5px}@media(max-width:650px){.ds-primary{min-height:52px}}"
    },
    {
      "name": "Screen exploration text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "The unboxed screen-exploration action shown against the sea.",
      "html": "<div class=\"ds-text-context\"><button class=\"ds-text\">Explore on this screen <span aria-hidden=\"true\">↗</span></button></div>",
      "css": ".ds-text-context{background:#145970;color:#fff9e8;padding:4px 16px}.ds-text{font:600 16px \"Segoe UI\",sans-serif;color:inherit;background:none;border:0;padding:15px 0;text-underline-offset:6px;cursor:pointer}.ds-text span{margin-left:12px}.ds-text:hover{text-decoration:underline}.ds-text:focus-visible{outline:3px solid var(--focus,#edbc65);outline-offset:5px}"
    },
    {
      "name": "Settings icon action",
