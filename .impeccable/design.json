  "narrative": {
    "northStar": "A tiny station in a vast painted ocean",
    "overview": "The supplied ocean storyboard is the visual authority. Brilliant summer blue, towering ivory clouds, reflected sky, and submerged rails make the world feel expansive. The little station supplies human scale without enclosing the view. The interface is sparse and welcoming, with illustrated-story lettering and small practical controls.\n\nThe environment fills the viewport. Nearby structures are real geometry; the painted sky is the distant backdrop. The welcome overlay recedes when exploration begins, and immersive sessions use a physical ticket-like menu inside the world. Movement begins only through an explicit action; the horizon remains stable during travel.",
    "keyCharacteristics": [
      "A huge bright-blue space with a clear, distant horizon.",
      "Painted clouds reflected in translucent, gently animated water.",
      "Warm paper, weathered timber, and subdued enamel at human scale.",
      "Literary display type paired with quiet, legible controls.",
      "Sparse screen overlays and native in-world controls for immersion."
    ],
    "rules": [
      {
        "name": "The Open Blue Rule",
        "body": "Preserve the broad blue sky and water as the dominant visual field; interface surfaces stay compact.",
        "section": "colors"
      },
      {
        "name": "The Quiet Lettering Rule",
        "body": "Use the bundled regular story face for invitations and titles; use the interface sans-serif for actions and instructions.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the large bright-blue field, reflected clouds, stable horizon, and human-scale station.",
      "**Do** keep welcome typography literary and operating controls plain and legible.",
      "**Do** retain clear keyboard focus and native form semantics.",
      "**Do** keep movement opt-in and provide reachable controls inside immersive sessions.",
      "**Do** ship the sky, font, and provenance with the application."
    ],
    "donts": [
      "**Don't** cover the world with large opaque content panels or decorative card grids.",
      "**Don't** substitute DOM-only controls for the in-world VR ticket.",
      "**Don't** treat reduced motion as a promise that every animated world object stops.",
      "**Don't** claim headset validation from desktop screenshots or implementation settings."
    ]
  }
}
