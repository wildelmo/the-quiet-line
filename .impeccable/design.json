      "description": "A circular enamel control with a thin line icon.",
      "html": "<button class=\"ds-icon\" aria-label=\"Open controls and settings\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16M9 4v6M15 14v6\"/></svg></button>",
      "css": ".ds-icon{width:44px;height:44px;border:1px solid #ffffff66;color:var(--paper,#fff9e8);background:#174956b8;border-radius:50%;display:grid;place-items:center;cursor:pointer}.ds-icon svg{width:22px;height:22px;stroke:currentColor;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}.ds-icon:hover{background:var(--ink,#173e4b)}.ds-icon:focus-visible{outline:3px solid var(--focus,#edbc65);outline-offset:5px}"
    },
    {
      "name": "Exploration toolbar",
      "kind": "nav",
      "refersTo": "toolbar",
      "description": "A compact enamel group with explicit hover and pressed states.",
      "html": "<div class=\"ds-tools\" role=\"group\" aria-label=\"Exploration controls\"><button aria-pressed=\"false\">Begin drifting</button><button>Next viewpoint</button><button aria-pressed=\"true\">Sound on</button><button>Return</button></div>",
      "css": ".ds-tools{display:flex;width:max-content;max-width:100%;border-radius:6px;background:#123f50ed;box-shadow:0 6px 24px #08354a22;padding:5px}.ds-tools button{font:13px \"Segoe UI\",sans-serif;background:none;border:0;color:var(--paper,#fff9e8);padding:12px 18px;min-height:44px;border-radius:3px;cursor:pointer}.ds-tools button:hover,.ds-tools button[aria-pressed=true]{background:#2d6677}.ds-tools button:focus-visible{outline:3px solid var(--focus,#edbc65);outline-offset:5px}@media(max-width:650px){.ds-tools button{font-size:12px;padding:10px 11px}}"
    },
    {
      "name": "Settings paper panel",
      "kind": "card",
      "refersTo": "settings-panel",
      "description": "The compact settings surface with native range and checkbox controls.",
      "html": "<section class=\"ds-settings\" aria-label=\"Settings\"><h2>Settle in.</h2><p>This is a place to be, with no destination to reach.</p><label class=\"ds-setting\">Sound <input aria-label=\"Sound volume\" type=\"range\" min=\"0\" max=\"100\" value=\"55\"></label><label class=\"ds-setting\">Quiet water <input type=\"checkbox\"></label></section>",
      "css": ".ds-settings{font:14px \"Segoe UI\",sans-serif;background:var(--paper,#fff9e8);color:var(--ink,#173e4b);padding:26px 28px;border-radius:5px;box-shadow:0 16px 65px #163d5240;width:360px;max-width:100%}.ds-settings h2{font:400 34px QuietStory,Georgia,serif;margin:0}.ds-settings p{line-height:1.6;margin:6px 0 25px}.ds-setting{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #c9d1c9;padding:16px 0;gap:16px}.ds-setting input[type=range]{width:145px;accent-color:var(--sea,#145970)}.ds-setting input[type=checkbox]{accent-color:var(--sea,#145970);width:20px;height:20px}.ds-setting input:focus-visible{outline:3px solid var(--focus,#edbc65);outline-offset:5px}"
    },
